<?xml version="1.0" encoding="utf-8"?>
<!-- No periodic updates: the app pushes changes and buttons refresh on press. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/glyph_widget_description"
    android:initialLayout="@layout/glyph_widget"
    android:previewLayout="@layout/glyph_widget"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:minResizeWidth="140dp"
    android:resizeMode="horizontal"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
